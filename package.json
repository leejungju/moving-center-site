{
  "name": "moving-center-site",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.browser.json",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "npm run build && vitest run",
    "db:migrate": "WRANGLER_SEND_METRICS=false wrangler d1 migrations apply DB --local",
    "dev": "npm run build && npm run db:migrate && WRANGLER_SEND_METRICS=false wrangler pages dev --port 8788",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "screenshots:static": "node scripts/screenshots-static.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "miniflare": "5.20261023.2-beta",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
